{
  "name": "startup-starter-kit",
  "version": "1.0.0",
  "description": "Production-ready Turborepo monorepo starter kit with Next.js 16, shadcn/ui, Tailwind CSS v4, Express 5, and Prisma 7",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,mjs}\"",
    "clean": "git clean -xdf node_modules"
  },
  "packageManager": "pnpm@12.4.1",
  "devDependencies": {
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.13"
  }
}
